# Copia esto a /etc/claude-watch.env con permisos 600 y dueno root.
# NUNCA lo metas en git: este repositorio es publico.
#
# Genera cada clave con:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"

# Clave del hook: abre /notify y /register-device.
CLAUDE_WATCH_API_KEY=PON_AQUI_LA_CLAVE_DEL_HOOK

# Clave del reloj: abre /projects y /ask*. Distinta de la del hook.
# Sin ella, los endpoints del reloj devuelven 503 a proposito.
CLAUDE_WATCH_ASK_KEY=PON_AQUI_LA_CLAVE_DEL_RELOJ
